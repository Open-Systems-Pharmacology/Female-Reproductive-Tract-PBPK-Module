@article{mannisto_concentrations_1984,
	title = {Concentrations of metronidazole and tinidazole in female reproductive organs after a single intravenous infusion and after repeated oral administration},
	volume = {12},
	copyright = {http://www.springer.com/tdm},
	issn = {0300-8126, 1439-0973},
	url = {http://link.springer.com/10.1007/BF01640899},
	doi = {10.1007/BF01640899},
	abstract = {Concentrations of metronidazole and tinidazole in serum and gynecological organs were analyzed after a single 500 mg intravenous infusion and after three days of treatment with 400 mg t.i.d, of metronidazole or 500 mg b.i.d, of tinidazoie. The studies were performed in 67 patients subjected to hysterectomy and/or oophorectomy because of myomatosis uteri, carcinoma uteri or endometriosis. At the time of organ removal (about 30 min after infusion), metronidazole and tinidazole levels in serum were 14.5 \_+ 0.45 rag/1 and 12.3 + 0.38 mg/1, respectively. Concentrations of both drugs in the uterus and Fallopian tube were about the same as the simultaneous serum levels and concentrations in the ovaries about 55\% thereof. At steady-state, the concentrations of tinidazole in serum (23.5 + 1.0 mg/l) were remarkably higher than those of metronidazole (13.5 --2-0.84 mg/1) about three hours after the last oral dose. Drug concentrations in organs of the female reproductive tract were 70 to 100\% those of the simultaneous serum levels.},
	language = {en},
	number = {3},
	urldate = {2025-02-21},
	journal = {Infection},
	author = {Männistö, P. and Haataja, H. and Karhunen, M. and Mattila, J. and Koskela, O. and Suikkari, A. -M. and Heinonen, P. and Tuimala, R.},
	month = may,
	year = {1984},
	pages = {197--201},
	file = {PDF:C\:\\Users\\NinaNauwelaerts\\Zotero\\storage\\YVGPKN4B\\Männistö et al. - 1984 - Concentrations of metronidazole and tinidazole in female reproductive organs after a single intraven.pdf:application/pdf},
}

