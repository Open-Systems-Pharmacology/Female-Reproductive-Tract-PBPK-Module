          <OutputFormulas>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Poulin and Theil.PARAM_K_rbc" name="PARAM_K_rbc" formula="(f_water_rbc + f_lipids_rbc * 10^LogMA + f_proteins_rbc * KProt)*fu">
