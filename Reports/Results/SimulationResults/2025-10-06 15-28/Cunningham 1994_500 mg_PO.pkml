            </KeyValue>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - Poulin and Theil.PARAM_K_cell_pls_Poulin_and_Theil" name="PARAM_K_cell_pls_Poulin_and_Theil" formula="(10^LogP * (V_nlt + 0.3 * V_pht) +  0.7 * V_pht + V_wt) / (10^LogP * (V_nlp + 0.3 * V_php) +  0.7 * V_php + V_wp) * (fu / fu_t)  ">
