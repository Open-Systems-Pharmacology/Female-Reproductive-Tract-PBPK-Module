              <Parameter id="WBiuDih1TESqbxZWvMVNSw" name="Permeability" description="Permeability" icon="Parameter" persistable="0" isFixedValue="0" dim="Velocity" quantityType="Parameter" negativeValuesAllowed="1" formula="GtCnYadPVUautKMLHszcQA" buildMode="Global" isDefault="1" displayUnit="cm/min">
