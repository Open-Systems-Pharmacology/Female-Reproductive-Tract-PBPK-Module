              <Parameter id="TeoDUahJwUCKSQd5V5UOGA" name="Density (drug)" description="Density of drug material" icon="Parameter" persistable="0" isFixedValue="0" dim="Density" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="1" displayUnit="g/cm³">
                <ValueOrigin id="32" source="Publication" description="Willmann S, Thelen K, Becker C, et al. Mechanism-based prediction of particle size-dependent dissolution and absorption: cilostazol pharmacokinetics in dogs. Eur J Pharm Biopharm. 2010 Sep;76(1):83-94 https://doi.org/10.1016/j.ejpb.2010.06.003" />
                <Info min="2.5E-06" flag="50" seq="32" ref="0" bb="2" group="14" />
              </Parameter>
              <Parameter id="aLr5ZXsfuUiMLHdNwONFhQ" name="Immediately dissolve particles smaller than" description="Threshold for the particle radius of immediate dissolution" icon="Parameter" persistable="0" isFixedValue="0" dim="Length" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="1E-07" displayUnit="µm">
                <ValueOrigin id="32" source="Publication" description="Willmann S, Thelen K, Becker C, et al. Mechanism-based prediction of particle size-dependent dissolution and absorption: cilostazol pharmacokinetics in dogs. Eur J Pharm Biopharm. 2010 Sep;76(1):83-94 https://doi.org/10.1016/j.ejpb.2010.06.003" />
